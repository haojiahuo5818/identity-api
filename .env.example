# Copy to .env and choose two different local passwords.
MYSQL_DATABASE=identity_api
MYSQL_USER=identity_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
PORT=3000

# Optional for local Node runs. Compose connects its API to the redis service.
# REDIS_URL=redis://127.0.0.1:6379
